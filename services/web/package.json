{
  "name": "cloudcure-web",
  "version": "0.1.0",
  "private": true,
  "description": "CloudCure v2 Node/Express BFF — htmx presentation layer over the CloudCure.Api service",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^3.1.0",
    "express": "^4.21.2",
    "express-openid-connect": "^2.17.1",
    "helmet": "^8.0.0",
    "htmx.org": "^2.0.4",
    "jsonwebtoken": "^9.0.2",
    "nunjucks": "^3.2.4",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/nunjucks": "^3.2.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
