{% extends "layout.njk" %}
{% block title %}Pending approvals — CloudCure{% endblock %}
{% block content %}
  <h1>Pending staff approvals</h1>
  {% if pending.length == 0 %}
    <p>No pending requests.</p>
  {% else %}
    <table>
      <thead>
        <tr><th>Name</th><th>Email</th><th>Requested</th><th>Grant role</th></tr>
      </thead>
      <tbody>
        {% for person in pending %}
          <tr>
            <td>{{ person.firstName }} {{ person.lastName }}</td>
            <td>{{ person.email }}</td>
            <td>{{ person.requestedAt }}</td>
            <td>
              <form method="post" action="/staff/pending-approvals/{{ person.personId }}/approve">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <select name="role" required>
                  <option value="Nurse">Nurse</option>
                  <option value="Doctor">Doctor</option>
                  <option value="Admin">Admin</option>
                </select>
                <button type="submit">Approve</button>
              </form>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}
{% endblock %}
