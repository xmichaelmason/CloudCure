# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# Postgres
POSTGRES_USER=cloudcure
POSTGRES_PASSWORD=cloudcure
POSTGRES_DB=cloudcure_v2

# Node BFF <-> .NET API internal service token (HS256 shared secret)
INTERNAL_JWT_SECRET=change-me-to-a-long-random-value

# Auth0 (Node BFF terminates the OIDC flow)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=change-me
AUTH0_CLIENT_SECRET=change-me
# Long random string used to encrypt the express-openid-connect session cookie
AUTH0_SECRET=change-me-to-a-long-random-value
AUTH0_BASE_URL=http://localhost:3000

# CSRF (csrf-csrf) secret
CSRF_SECRET=change-me-to-a-long-random-value

# Observability (OpenObserve) — must be 8-128 chars with upper/lower/digit/special char
OBSERVABILITY_ADMIN_PASSWORD=Change-Me-1!
